# Normalize text files in the repo; keep platform-critical endings fixed.
* text=auto
# Keep portable scripts and historical research files on LF.
*.sh text eol=lf
*.py text eol=lf
uv.toml text eol=lf
# PowerShell scripts are consumed on Windows only.
*.ps1 text eol=crlf
*.png binary
*.wav binary
*.tar binary
# Preserve whitespace in the upstream model template used as an exact fixture.
tests/fixtures/dictation/agentic-author-chat_template.jinja -whitespace
